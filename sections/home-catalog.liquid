{%- liquid
  assign all_prods = collections.all.products
-%}

<div class="editorial-shell">
  <!-- 1. Barra Superior Boutique -->
  <div class="announcement-bar">
    <span>Despacho desde Guayaquil · Todo Ecuador</span>
    <span class="announcement-bar__tag">Pago al Recibir</span>
  </div>

  <!-- 2. Cabecera de Marca -->
  <header class="brand-header">
    <div class="brand-logo">{{ shop.name | default: 'CASA ALIVIO™' }}</div>
    <div class="brand-location">Ecuador · Contraentrega</div>
  </header>

  <!-- 3. Hero de Bienvenida Editorial -->
  <section class="section-block section-block--sand" style="text-align: center; padding: 36px 20px 28px;">
    <span class="editorial-kicker">Catálogo Oficial de Soluciones</span>
    <h1 class="editorial-headline" style="font-size: 28px; margin-bottom: 12px;">
      Productos diseñados para <em>ahorrarte esfuerzo y cuidar tu salud.</em>
    </h1>
    <p class="editorial-subline" style="max-width: 380px; margin: 0 auto 16px; font-size: 14px;">
      Selección exclusiva de soluciones prácticas para el hogar y tu bienestar diario. Despachamos en 24-48 horas y pagas en efectivo en tu puerta.
    </p>
  </section>

  <!-- 4. Cinta de Garantías -->
  <div class="trust-strip">
    <span>✓ Envío a Domicilio</span>
    <span>✓ Pagas al Recibir</span>
    <span>✓ Garantía Local</span>
  </div>

  <!-- 5. Listado de Productos Destacados -->
  <section class="section-block section-block--white" style="padding: 28px 16px;">
    <span class="editorial-kicker" style="margin-bottom: 6px;">Nuestros Productos</span>
    <h2 class="section-title" style="font-size: 24px; margin-bottom: 20px;">Elige una solución para ver su demostración:</h2>

    <div style="display: flex; flex-direction: column; gap: 24px;">

      <!-- Producto 1: Cepillo 9 en 1 Pro -->
      <article class="pain-editorial-card" style="box-shadow: 0 4px 16px rgba(28,25,23,0.06);">
        <div class="pain-editorial-card__img" style="aspect-ratio: 16/10;">
          <img
            src="{{ 'relief_standing_clean.jpg' | asset_url }}"
            alt="Cepillo Eléctrico 9 en 1 Pro"
            loading="lazy"
            onerror="this.src='https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=800&q=80'"
          >
        </div>
        <div class="pain-editorial-card__body">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <span class="pain-number" style="color: var(--accent-terracotta);">Hogar & Limpieza</span>
            <span style="font-family: var(--font-serif); font-size: 20px; font-weight: 600; color: var(--text-espresso);">
              {% if all_products['cepillo-electrico-9-en-1-pro'] != blank %}
                {{ all_products['cepillo-electrico-9-en-1-pro'].price | money }}
              {% else %}
                $44.90 USD
              {% endif %}
            </span>
          </div>
          <h3 class="pain-editorial-card__title" style="font-size: 19px;">
            Cepillo Eléctrico 9 en 1 Pro
          </h3>
          <p class="pain-editorial-card__desc">
            Limpia baños, azulejos, estufas y pisos de pie sin doblar la espalda. Motor 300 RPM con 9 cabezales intercambiables y brazo de 1.20 m.
          </p>
          <a
            href="/products/cepillo-electrico-9-en-1-pro"
            class="btn-editorial-primary"
            style="text-decoration: none; padding: 13px 18px; margin-top: 8px;"
          >
            <span>Ver Demostración & Pedir</span>
            <small>Pagas al recibir en casa</small>
          </a>
        </div>
      </article>

      <!-- Producto 2: Mini Licuadora Conejito Portátil -->
      <article class="pain-editorial-card" style="box-shadow: 0 4px 16px rgba(28,25,23,0.06);">
        <div class="pain-editorial-card__img" style="aspect-ratio: 16/10;">
          <img
            src="{{ 'blender_bunny_hero.jpg' | asset_url }}"
            alt="Mini Licuadora Conejito Portátil"
            loading="lazy"
            onerror="this.src='https://images.unsplash.com/photo-1553530666-ba11a7da3888?auto=format&fit=crop&w=800&q=80'"
          >
        </div>
        <div class="pain-editorial-card__body">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <span class="pain-number" style="color: var(--accent-terracotta);">Nutrición & Hábitos</span>
            <span style="font-family: var(--font-serif); font-size: 20px; font-weight: 600; color: var(--text-espresso);">
              {% if all_products['mini-licuadora-conejito-portatil'] != blank %}
                {{ all_products['mini-licuadora-conejito-portatil'].price | money }}
              {% else %}
                $29.90 USD
              {% endif %}
            </span>
          </div>
          <h3 class="pain-editorial-card__title" style="font-size: 19px;">
            Mini Licuadora Conejito Portátil
          </h3>
          <p class="pain-editorial-card__desc">
            Batidos frescos y espumosos en 30 segundos sin ensuciar la licuadora gigante. Tomas del mismo vaso y se auto-lava sola con agua.
          </p>
          <a
            href="/products/mini-licuadora-conejito-portatil"
            class="btn-editorial-primary"
            style="text-decoration: none; padding: 13px 18px; margin-top: 8px;"
          >
            <span>Ver Demostración & Pedir</span>
            <small>Pagas al recibir en casa</small>
          </a>
        </div>
      </article>

      <!-- Producto 3: Masajeador Capilar Antiestrés -->
      <article class="pain-editorial-card" style="box-shadow: 0 4px 16px rgba(28,25,23,0.06);">
        <div class="pain-editorial-card__img" style="aspect-ratio: 16/10;">
          <img
            src="{{ 'massager_scalp_hero.jpg' | asset_url }}"
            alt="Masajeador Capilar Antiestrés"
            loading="lazy"
            onerror="this.src='https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80'"
          >
        </div>
        <div class="pain-editorial-card__body">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <span class="pain-number" style="color: var(--accent-terracotta);">Bienestar & Relajación</span>
            <span style="font-family: var(--font-serif); font-size: 20px; font-weight: 600; color: var(--text-espresso);">
              {% if all_products['masajeador-capilar-antiestres'] != blank %}
                {{ all_products['masajeador-capilar-antiestres'].price | money }}
              {% else %}
                $42.50 USD
              {% endif %}
            </span>
          </div>
          <h3 class="pain-editorial-card__title" style="font-size: 19px;">
            Masajeador Capilar Antiestrés
          </h3>
          <p class="pain-editorial-card__desc">
            Alivio instantáneo de migrañas, estrés y rigidez cervical en 5 minutos. Nodos 3D de silicona suave y resistente al agua en la ducha.
          </p>
          <a
            href="/products/masajeador-capilar-antiestres"
            class="btn-editorial-primary"
            style="text-decoration: none; padding: 13px 18px; margin-top: 8px;"
          >
            <span>Ver Demostración & Pedir</span>
            <small>Pagas al recibir en casa</small>
          </a>
        </div>
      </article>

    </div>
  </section>

  <!-- 6. Tarjeta de Pago Seguro Contraentrega -->
  <section class="section-block section-block--sand" style="padding: 24px 20px;">
    <div class="cod-editorial-card" style="margin-top: 0;">
      <img
        src="{{ 'cod_door_delivery.jpg' | asset_url }}"
        alt="Entrega en puerta a domicilio"
        loading="lazy"
      >
      <div class="cod-editorial-card__text">
        <strong>Compra 100% libre de riesgo</strong>
        <p>No pedimos tarjetas. Despachamos desde nuestra bodega en Guayaquil y pagas en efectivo cuando el repartidor te entregue la caja.</p>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Catalogo Editorial",
  "settings": []
}
{% endschema %}
