    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Slider Antes (Junta con moho)"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Slider Despues (Azulejo limpio)"
    },
    {
      "type": "image_picker",
      "id": "hands_image",
      "label": "Foto Manos irritadas (Quimicos)"
    },
    {
      "type": "image_picker",
      "id": "relief_image",
      "label": "Foto Uso erguido en ducha"
    },
    {
      "type": "image_picker",
      "id": "zone_corners_image",
      "label": "Foto Cabezal conico en grifo"
    },
