<!-- BARRA FIJA INFERIOR -->
<div class="spa-sticky-bar">
  <div class="spa-stepper">
    <button type="button" onclick="changeMassagerQty(-1)">−</button>
    <span id="mStickyQty">1</span>
    <button type="button" onclick="changeMassagerQty(1)">+</button>
  </div>

  <div class="spa-sticky-info">
    <span>Total al recibir</span>
    <strong id="mStickyTotal">${{ price_usd | string }}</strong>
  </div>

  <button
    type="button"
    class="spa-sticky-btn"
    onclick="checkoutMassager()"
  >
    Pedir
  </button>
</div>

<script>
  (function() {
    var basePrice = {{ price_usd | json }};
    var baseCompare = {{ compare_usd | json }};
    var variantId = {{ current_variant.id | json }};
    var currentQty = 1;
    var maxQty = 10;

    function formatMoney(num) {
      return '$' + Number(num).toFixed(2);
    }

    function updateUi() {
      var totalPrice = basePrice * currentQty;
      var totalCompare = baseCompare * currentQty;
      var savings = totalCompare - totalPrice;

      document.getElementById('mQtyVal').textContent = currentQty;
      document.getElementById('mQtyValFinal').textContent = currentQty;
      document.getElementById('mStickyQty').textContent = currentQty;

      document.getElementById('mPriceNow').textContent = formatMoney(totalPrice);
      document.getElementById('mPriceOld').textContent = formatMoney(totalCompare) + ' USD';
      document.getElementById('mSavePill').textContent = 'Ahorras ' + formatMoney(savings) + ' Hoy';

      document.getElementById('mStickyTotal').textContent = formatMoney(totalPrice);
      document.getElementById('mTotalText').textContent = currentQty + 'x Masajeador(es) por ' + formatMoney(totalPrice) + ' USD';
      document.getElementById('mQtyLabel').textContent = currentQty === 1 ? '1 unidad para envío inmediato' : currentQty + ' unidades seleccionadas';
    }

    window.changeMassagerQty = function(delta) {
      var next = currentQty + delta;
      if (next >= 1 && next <= maxQty) {
        currentQty = next;
        updateUi();
      }
    };

    window.checkoutMassager = function() {
      var externalCodBtn = document.querySelector('.rsi-cod-form-button, [data-rsi-cod-btn], .es-popup-button, #rsi-cod-form-open');
      if (externalCodBtn) {
        externalCodBtn.click();
        return;
      }

      if (variantId) {
        window.location.href = '/cart/' + variantId + ':' + currentQty;
      } else {
        alert('Preparando pedido para ' + currentQty + ' unidad(es).');
      }
    };
  })();
</script>
