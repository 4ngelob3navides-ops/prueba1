{%- liquid
  assign target_product = product
  if target_product == blank and section.settings.featured_product != blank
    assign target_product = section.settings.featured_product
  endif
  if target_product == blank
    assign target_product = all_products['masajeador-capilar-antiestres']
  endif
  if target_product == blank and collections.all.products.size > 0
    assign target_product = collections.all.products.first
  endif

  assign current_variant = target_product.selected_or_first_available_variant

  assign price_cents = current_variant.price | default: 3990
  assign price_usd = price_cents | divided_by: 100.0

  assign compare_cents = current_variant.compare_at_price | default: 0
  if compare_cents <= price_cents
    assign compare_cents = price_cents | times: 1.5
  endif
  assign compare_usd = compare_cents | divided_by: 100.0
  assign savings_usd = compare_usd | minus: price_usd

  assign real_stock = current_variant.inventory_quantity | default: 16
  if real_stock <= 0
    assign real_stock = 16
  endif
-%}

