  <!-- 6. OFERTA FINAL Y CONFIRMACIÓN CONTRAENTREGA -->
  <section class="blender-section" id="pedir-conejito">
    <span class="blender-kicker">Despacho desde Guayaquil</span>
    <h2 class="blender-section-title">Pídela hoy con Envío Gratis y Pago en Casa.</h2>
    <p class="blender-section-sub">
      No pagas nada por adelantado. Recibes en tu puerta en 24 a 48 horas y pagas al repartidor.
    </p>

    <div class="blender-qty-row" style="margin-bottom: 16px;">
      <div>
        <strong style="font-size: 14px; display: block;">Total a pagar:</strong>
        <span id="bTotalText" style="font-size: 12px; color: var(--blender-green-dark); font-weight: 700;">
          1x Licuadora por ${{ price_usd | string }} USD
        </span>
      </div>
      <div class="blender-stepper">
        <button type="button" onclick="changeBlenderQty(-1)">−</button>
        <span id="bQtyValFinal">1</span>
        <button type="button" onclick="changeBlenderQty(1)">+</button>
      </div>
    </div>

    <button
      type="button"
      class="blender-btn-cta"
      onclick="checkoutBlender()"
    >
      <span>Confirmar Pedido Contraentrega</span>
      <small>🚚 Pagas solo cuando te entreguen la caja en tu puerta</small>
    </button>

    <div style="display: flex; gap: 12px; align-items: center; background: #F8FAFC; border: 1px solid var(--blender-border-light); border-radius: 12px; padding: 12px; margin-top: 16px;">
      <img
        src="{{ 'cod_door_delivery.jpg' | asset_url }}"
        alt="Entrega en puerta"
        style="width: 75px; height: 75px; object-fit: cover; border-radius: 8px;"
        loading="lazy"
      >
      <div style="font-size: 12px; color: var(--blender-text-muted);">
        <strong style="font-size: 13.5px; color: var(--blender-text-main); display: block; margin-bottom: 2px;">Compra 100% segura</strong>
        Despachamos desde Guayaquil a todas las ciudades de Ecuador. Garantía de 30 días contra cualquier defecto.
      </div>
    </div>
  </section>

</div>

<!-- BARRA FIJA INFERIOR -->
<div class="blender-sticky-bar">
  <div class="blender-stepper">
    <button type="button" onclick="changeBlenderQty(-1)">−</button>
    <span id="bStickyQty">1</span>
    <button type="button" onclick="changeBlenderQty(1)">+</button>
  </div>

  <div class="blender-sticky-info">
    <span>Total al recibir</span>
    <strong id="bStickyTotal">${{ price_usd | string }}</strong>
  </div>

  <button
    type="button"
    class="blender-sticky-btn"
    onclick="checkoutBlender()"
  >
    Pedir
  </button>
</div>

<script>
  (function() {
    var basePrice = {{ price_usd | json }};
    var baseCompare = {{ compare_usd | json }};
    var variantId = {{ current_variant.id | json }};
    var currentQty = 1;
    var maxQty = 10;

    function formatMoney(num) {
      return '$' + Number(num).toFixed(2);
    }

    function updateUi() {
      var totalPrice = basePrice * currentQty;
      var totalCompare = baseCompare * currentQty;
      var savings = totalCompare - totalPrice;

      document.getElementById('bQtyVal').textContent = currentQty;
      document.getElementById('bQtyValFinal').textContent = currentQty;
      document.getElementById('bStickyQty').textContent = currentQty;

      document.getElementById('bPriceNow').textContent = formatMoney(totalPrice);
      document.getElementById('bPriceOld').textContent = formatMoney(totalCompare) + ' USD';
      document.getElementById('bSavePill').textContent = 'Ahorras ' + formatMoney(savings) + ' Hoy';

      document.getElementById('bStickyTotal').textContent = formatMoney(totalPrice);
      document.getElementById('bTotalText').textContent = currentQty + 'x Licuadora(s) por ' + formatMoney(totalPrice) + ' USD';
      document.getElementById('bQtyLabel').textContent = currentQty === 1 ? '1 unidad para envío inmediato' : currentQty + ' unidades seleccionadas';
    }

    window.changeBlenderQty = function(delta) {
      var next = currentQty + delta;
      if (next >= 1 && next <= maxQty) {
        currentQty = next;
        updateUi();
      }
    };

    window.checkoutBlender = function() {
      var externalCodBtn = document.querySelector('.rsi-cod-form-button, [data-rsi-cod-btn], .es-popup-button, #rsi-cod-form-open');
      if (externalCodBtn) {
        externalCodBtn.click();
        return;
      }

      if (variantId) {
        window.location.href = '/cart/' + variantId + ':' + currentQty;
      } else {
        alert('Preparando pedido para ' + currentQty + ' unidad(es).');
      }
    };
  })();
</script>

